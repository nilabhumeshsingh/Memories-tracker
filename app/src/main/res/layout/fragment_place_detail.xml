<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="args"
            type="myplaces.ui.PlaceDetailFragmentArgs" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <!-- Full Photo -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivDetailImage"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:scaleType="centerCrop"
                app:imageUri="@{args.currentItem.image}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/ic_location" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:text="@{args.currentItem.title}"
                android:textColor="@color/secondaryColor"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivDetailImage"
                tools:text="Blue Door Cafe" />

            <!-- Date & Category -->
            <LinearLayout
                android:id="@+id/llMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDetailTitle">

                <TextView
                    android:id="@+id/tvDetailDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{args.currentItem.date}"
                    android:textColor="@color/tabUnselectedTextColor"
                    android:textSize="14sp"
                    tools:text="20.08.2026 03:00" />

                <TextView
                    android:id="@+id/tvDetailCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_item"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="@{args.currentItem.category}"
                    android:textColor="@color/secondaryColor"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="visible"
                    tools:text="Food" />
            </LinearLayout>

            <!-- Description / Personal Note -->
            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:lineSpacingExtra="4dp"
                android:text="@{args.currentItem.description}"
                android:textColor="@color/secondaryTextColor"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llMeta"
                tools:text="Best iced latte, quiet corner seat" />

            <!-- Coordinates text -->
            <TextView
                android:id="@+id/tvDetailCoordinates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:text="@{String.format(@string/coordinates_format, args.currentItem.latitude, args.currentItem.longitude)}"
                android:textColor="@color/secondaryColor"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDetailDescription"
                tools:text="Coordinates: 40.712800, -74.006000" />

            <!-- Location / Address -->
            <TextView
                android:id="@+id/tvDetailLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:text="@{args.currentItem.location}"
                android:textColor="@color/tabUnselectedTextColor"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDetailCoordinates"
                tools:text="New York, NY 10001" />

            <!-- Action Buttons Grid -->

            <!-- Open in Google Maps (Primary Action) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenGoogleMaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:padding="12dp"
                android:text="@string/open_in_google_maps"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:backgroundTint="@color/secondaryColor"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_map_external"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDetailLocation" />

            <!-- Secondary Actions: Share & View on In-App Map -->
            <LinearLayout
                android:id="@+id/llSecondaryActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnOpenGoogleMaps">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/share_place"
                    android:textColor="@color/secondaryColor"
                    app:icon="@drawable/ic_share"
                    app:iconTint="@color/secondaryColor"
                    app:strokeColor="@color/secondaryColor" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewOnMap"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/place_detail_btn_view_map"
                    android:textColor="@color/secondaryColor"
                    app:icon="@drawable/ic_location"
                    app:iconTint="@color/secondaryColor"
                    app:strokeColor="@color/secondaryColor" />
            </LinearLayout>

            <!-- Management Actions: Edit & Delete -->
            <LinearLayout
                android:id="@+id/llManagementActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llSecondaryActions">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/edit_place"
                    android:textColor="@color/secondaryColor"
                    app:icon="@drawable/ic_edit_location"
                    app:iconTint="@color/secondaryColor"
                    app:strokeColor="@color/secondaryColor" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/delete_place"
                    android:textColor="@color/swipeDeleteColor"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/swipeDeleteColor"
                    app:strokeColor="@color/swipeDeleteColor" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>